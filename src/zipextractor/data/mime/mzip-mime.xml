<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- ZIP Archives -->
  <mime-type type="application/zip">
    <comment>ZIP archive</comment>
    <comment xml:lang="en">ZIP archive</comment>
    <glob pattern="*.zip"/>
    <glob pattern="*.ZIP"/>
    <magic priority="50">
      <match type="string" value="PK\003\004" offset="0"/>
    </magic>
  </mime-type>

  <!-- 7-Zip Archives -->
  <mime-type type="application/x-7z-compressed">
    <comment>7-Zip archive</comment>
    <comment xml:lang="en">7-Zip archive</comment>
    <glob pattern="*.7z"/>
    <glob pattern="*.7Z"/>
    <magic priority="50">
      <match type="string" value="7z\274\257\047\034" offset="0"/>
    </magic>
  </mime-type>

  <!-- RAR Archives -->
  <mime-type type="application/x-rar-compressed">
    <comment>RAR archive</comment>
    <comment xml:lang="en">RAR archive</comment>
    <glob pattern="*.rar"/>
    <glob pattern="*.RAR"/>
    <magic priority="50">
      <match type="string" value="Rar!\032\007" offset="0"/>
    </magic>
  </mime-type>

  <!-- TAR Archives -->
  <mime-type type="application/x-tar">
    <comment>TAR archive</comment>
    <comment xml:lang="en">TAR archive</comment>
    <glob pattern="*.tar"/>
    <glob pattern="*.TAR"/>
    <magic priority="50">
      <match type="string" value="ustar" offset="257"/>
    </magic>
  </mime-type>

  <!-- GZIP Compressed TAR -->
  <mime-type type="application/x-compressed-tar">
    <comment>Gzip compressed TAR archive</comment>
    <comment xml:lang="en">Gzip compressed TAR archive</comment>
    <glob pattern="*.tar.gz"/>
    <glob pattern="*.tgz"/>
    <glob pattern="*.TAR.GZ"/>
    <glob pattern="*.TGZ"/>
    <sub-class-of type="application/gzip"/>
  </mime-type>

  <!-- BZIP2 Compressed TAR -->
  <mime-type type="application/x-bzip-compressed-tar">
    <comment>Bzip2 compressed TAR archive</comment>
    <comment xml:lang="en">Bzip2 compressed TAR archive</comment>
    <glob pattern="*.tar.bz2"/>
    <glob pattern="*.tbz2"/>
    <glob pattern="*.tbz"/>
    <glob pattern="*.TAR.BZ2"/>
    <sub-class-of type="application/x-bzip"/>
  </mime-type>

  <!-- XZ Compressed TAR -->
  <mime-type type="application/x-xz-compressed-tar">
    <comment>XZ compressed TAR archive</comment>
    <comment xml:lang="en">XZ compressed TAR archive</comment>
    <glob pattern="*.tar.xz"/>
    <glob pattern="*.txz"/>
    <glob pattern="*.TAR.XZ"/>
    <sub-class-of type="application/x-xz"/>
  </mime-type>

  <!-- GZIP -->
  <mime-type type="application/gzip">
    <comment>Gzip archive</comment>
    <comment xml:lang="en">Gzip archive</comment>
    <glob pattern="*.gz"/>
    <glob pattern="*.GZ"/>
    <magic priority="50">
      <match type="string" value="\037\213" offset="0"/>
    </magic>
  </mime-type>

  <!-- BZIP2 -->
  <mime-type type="application/x-bzip2">
    <comment>Bzip2 archive</comment>
    <comment xml:lang="en">Bzip2 archive</comment>
    <glob pattern="*.bz2"/>
    <glob pattern="*.BZ2"/>
    <magic priority="50">
      <match type="string" value="BZh" offset="0"/>
    </magic>
  </mime-type>

  <!-- XZ -->
  <mime-type type="application/x-xz">
    <comment>XZ archive</comment>
    <comment xml:lang="en">XZ archive</comment>
    <glob pattern="*.xz"/>
    <glob pattern="*.XZ"/>
    <magic priority="50">
      <match type="string" value="\375\067\172\130\132\000" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
